{
  "name": "melbourne-pixel-train",
  "version": "1.0.0",
  "private": true,
  "description": "A pixel-art train journey from Flinders Street to Belgrave, with a Playwright test suite",
  "scripts": {
    "start": "http-server . -p 4173 -c-1 -o",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "http-server": "^14.1.1"
  }
}
